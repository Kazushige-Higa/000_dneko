
RewriteEngine On

# HTML/CSS/JavaScript/SVG/JSONを圧縮して転送量を削減する
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

# 静的ファイルをブラウザキャッシュし、再訪時の転送量を削減する
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:avif|webp|jpe?g|png|gif|svg)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# 公開URLは /sitemap.xml のまま、PHPで最新の内容を生成する
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# localhost以外のホスト名を正規ドメインへ1回で統一する
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^d-neko\.com$ [NC]
RewriteRule ^ https://d-neko.com%{REQUEST_URI} [R=301,L,NE]

# localhostではHTTPのまま表示し、公開環境だけHTTPSへ統一する
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://d-neko.com%{REQUEST_URI} [R=301,L,NE]

# 公開環境だけ /index.php を / に正規化する
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?$ [NC]
RewriteRule ^index\.(?:html|php)$ / [R=301,L]

# 設定用FAQテンプレートの直アクセスは正規FAQページへ統一する
RewriteRule ^microCMS_FAQ_customfield/faq\.php$ faq.php [R=301,L]

# デザインまるっとお任せプランの推奨URL
RewriteCond %{THE_REQUEST} \s/+service_marutto\.php(?:[?\s]) [NC]
RewriteRule ^service_marutto\.php$ /marutto-plan/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+marutto-plan\.php(?:[?\s]) [NC]
RewriteRule ^marutto-plan\.php$ /marutto-plan/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+marutto-plan(?:[?\s]) [NC]
RewriteRule ^marutto-plan$ /marutto-plan/ [R=301,L]
RewriteRule ^marutto-plan/?$ service_marutto.php [L]

# 存在しないURLはトップへ転送せず、404ページを正しいステータスで返す
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
